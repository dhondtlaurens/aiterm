{
  "agy" : {
    "challenge" : [
      "agy",
      "-p",
      "{prompt}",
      "--output-format",
      "json",
      "--settings",
      "{\"permissions\":{\"deny\":[\"command(*)\",\"write_file(*)\",\"mcp(*)\",\"url(*)\",\"unsandboxed(*)\"]},\"trustedWorkspaces\":[\"{folder}\",\"{project}\"]}",
      "--add-dir",
      "{project}",
      "--model",
      "{model}"
    ],
    "resume" : [
      "agy",
      "--conversation",
      "{conversation}",
      "--dangerously-skip-permissions",
      "--model",
      "{model}"
    ],
    "review" : [
      "agy",
      "--dangerously-skip-permissions",
      "--settings",
      "{\"permissions\":{\"deny\":[\"write_file(*)\",\"command(git commit)\",\"command(git checkout)\",\"command(git switch)\",\"command(git reset)\",\"command(git rebase)\",\"command(git merge)\",\"command(git stash)\",\"command(git add)\"]}}",
      "--model",
      "{model}"
    ],
    "task" : [
